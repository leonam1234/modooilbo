{
  "name": "modooilbo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "content": "node scripts/build-content.mjs",
    "prebuild": "node scripts/convert-webp.mjs && node scripts/build-content.mjs && node scripts/build-trending-data.mjs",
    "build": "next build",
    "postbuild": "npm run test:email-obfuscation && npm run test:seo",
    "start": "next start",
    "lint": "tsc --noEmit",
    "lint:functions": "tsc -p tsconfig.functions.json",
    "lint:all": "npm run lint && npm run lint:functions",
    "preview:static": "node scripts/static-server.mjs",
    "deploy:preview": "node scripts/deploy.mjs preview",
    "deploy:prod": "node scripts/deploy.mjs prod",
    "deploy:cf": "node scripts/deploy.mjs prod",
    "report:tracking": "node scripts/tracking-report.mjs",
    "report:visibility": "node scripts/search-visibility-report.mjs",
    "report:reporting": "node scripts/reporting-report.mjs",
    "report:editorial": "node scripts/editorial-quality-report.mjs",
    "check:editorial": "node scripts/editorial-quality-report.mjs --strict",
    "test:editorial": "node scripts/editorial-quality.test.mjs",
    "test:email-obfuscation": "node --test scripts/email-obfuscation.test.mjs",
    "test:seo": "node --test scripts/seo-regression.test.mjs",
    "check:preview-assets": "node scripts/check-preview-assets.mjs",
    "test:preview-assets": "node --test scripts/check-preview-assets.test.mjs",
    "fetch:stock": "node scripts/fetch-stock.mjs",
    "smoke": "node scripts/mobile-smoke.mjs"
  },
  "dependencies": {
    "next": "15.5.20",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.60.0",
    "postcss": "^8.5.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wrangler": "^4.105.0"
  }
}
