{
  "name": "modooilbo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "content": "node scripts/build-content.mjs",
    "prebuild": "node scripts/convert-webp.mjs && node scripts/build-content.mjs && node scripts/build-trending-data.mjs",
    "build": "next build",
    "postbuild": "npm test",
    "test": "node --test scripts/*.test.mjs",
    "start": "next start",
    "lint": "tsc --noEmit",
    "lint:functions": "tsc -p tsconfig.functions.json",
    "lint:all": "npm run lint && npm run lint:functions",
    "preview:static": "node scripts/static-server.mjs",
    "deploy:preview": "node scripts/deploy.mjs preview",
    "deploy:prod": "node scripts/deploy.mjs prod",
    "deploy:cf": "node scripts/deploy.mjs prod",
    "release:preview": "node scripts/deploy.mjs preview --build-once",
    "release:prod": "node scripts/deploy.mjs prod",
    "report:tracking": "node scripts/tracking-report.mjs",
    "report:visibility": "node scripts/search-visibility-report.mjs",
    "report:reporting": "node scripts/reporting-report.mjs",
    "report:editorial": "node scripts/editorial-quality-report.mjs",
    "check:editorial": "node scripts/editorial-quality-report.mjs --strict",
    "test:editorial": "node scripts/editorial-quality.test.mjs",
    "test:email-obfuscation": "node --test scripts/email-obfuscation.test.mjs",
    "test:seo": "node --test scripts/seo-regression.test.mjs",
    "test:analytics": "node --test scripts/google-analytics.test.mjs",
    "test:tracking-report": "node --test scripts/tracking-rum.test.mjs",
    "check:preview-assets": "node scripts/check-preview-assets.mjs",
    "test:preview-assets": "node --test scripts/check-preview-assets.test.mjs",
    "test:r2-cache": "node --test scripts/r2-sync-cache.test.mjs",
    "test:mobile-smoke": "node --test scripts/mobile-smoke-concurrency.test.mjs",
    "test:inspection-safety": "node --test scripts/inspection-safety.test.mjs scripts/mobile-smoke-concurrency.test.mjs scripts/check-preview-assets.test.mjs",
    "test:release-artifact": "node --test scripts/release-artifact.test.mjs",
    "fetch:stock": "node scripts/fetch-stock.mjs",
    "smoke": "node scripts/mobile-smoke.mjs"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.1",
    "miniflare": "5.20260911.1-alpha",
    "playwright": "^1.60.0",
    "postcss": "^8.5.23",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wrangler": "^4.131.2"
  }
}
